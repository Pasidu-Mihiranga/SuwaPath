# --- Database ---
# Most PostgreSQL installations use port 5432; this project's Homebrew
# instance was configured for 5436. Check yours and edit this line rather
# than reconfiguring the server.
#   macOS/Linux : postgresql+psycopg2://YOUR_USERNAME@127.0.0.1:5436/suwapath
#   Windows     : postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/suwapath
DATABASE_URL=postgresql+psycopg2://YOUR_USERNAME@127.0.0.1:5436/suwapath

# --- Auth ---
# Change this before any non-local deployment.
JWT_SECRET=suwapath-dev-secret-change-in-production

# --- Language models ---
# All three are OPTIONAL and are tried in the order below. Whichever answers
# first wins; a provider that fails is skipped for 60 seconds. With none of
# them set, the platform still runs end to end on deterministic composers —
# the wording is plainer, nothing else changes.
#
# 1. Groq — by far the fastest free tier (160-450ms). Set this one if you only
#    set one. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=groq/compound-mini

# 2. OpenRouter — free model slugs, slower and more often rate-limited.
#    Free slugs change; check https://openrouter.ai/models?max_price=0
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 3. Gemini — note that free keys are frequently provisioned with a quota of
#    zero, which presents as a 429 on the very first call. Model slugs get
#    retired too; "gemini-flash-latest" tracks Google's current default so
#    this doesn't need bumping every time they cycle a version.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Set to false to disable silent fallback to rule-based canned text when AI fails
ALLOW_RULE_BASED_FALLBACK=true

# --- Web search ---
# Optional. Used only for current public information (outbreaks, recalls), and
# never to set urgency. Queries are filtered for anything personal before they
# leave, because a search provider logs them indefinitely.
TAVILY_API_KEY=

# --- Knowledge retrieval ---
# Leave QDRANT_URL empty to use the embedded on-disk Qdrant in backend/storage.
# No server, no container.
QDRANT_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- OCR ---
# Only needed on Windows, or if tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Computer vision ---
# Drop a trained pneumonia model at models/pneumonia/*.onnx and the ONNX adapter
# takes over automatically from the bundled baseline.

# Encryption key for stored conversation content (AES-256-GCM).
# Generate: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this makes existing encrypted conversations unreadable.
SUWAPATH_ENCRYPTION_KEY=
