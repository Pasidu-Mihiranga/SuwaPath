# --- Database ---
# Defaults to the local Homebrew PostgreSQL 16 instance on port 5436.
DATABASE_URL=postgresql+psycopg2://YOUR_MACOS_USERNAME@127.0.0.1:5436/suwapath

# --- Auth ---
# Change this before any non-local deployment.
JWT_SECRET=suwapath-dev-secret-change-in-production

# --- AI orchestration ---
# Without a key the platform still works end to end: the LangGraph orchestrator
# falls back to deterministic intake and explanation. With a key, Gemini writes
# the conversation and extracts structure.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. Used only for current public information, never for clinical or
# emergency decisions.
TAVILY_API_KEY=

# --- Knowledge retrieval ---
# Leave QDRANT_URL empty to use the embedded on-disk Qdrant in backend/storage.
QDRANT_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Computer vision ---
# Drop a trained pneumonia model at models/pneumonia/*.onnx and the ONNX adapter
# takes over automatically from the bundled baseline.
